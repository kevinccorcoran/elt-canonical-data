# docker/airflow/.env — template (NO SECRETS). Copy to `.env` and fill in.
#   cp .env.example .env   # then edit
# The .env file itself is gitignored; only this template is tracked.
# Compose reads `.env` (anchor `env_file` + the postgres service).

# --- Airflow metadata DB (the airflow-postgres container, dbname=airflow) ---
# Must NOT be reachable off-host; the container publishes 127.0.0.1:5435->5432.
POSTGRES_USER=airflow
POSTGRES_PASSWORD=changeme
POSTGRES_DB=airflow
AIRFLOW_DATABASE_URL=postgresql+psycopg2://airflow:changeme@postgres:5432/airflow
AIRFLOW__WEBSERVER__SECRET_KEY=generate-a-random-hex-key

# --- Local trading DB the DAGs read (Mac-native Postgres via host.docker.internal) ---
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=changeme

# --- Managed prod DB (DigitalOcean) the dashboard's Production preset dials ---
PROD_DB_HOST=your-db.ondigitalocean.com
PROD_DB_PORT=25060
PROD_DB_USER=doadmin
PROD_DB_PASSWORD=changeme
# PROD_DB_NAME=prod          # optional; app.R DB_ENVIRONMENTS default is "prod"

# --- Optional overrides consumed by scripts/app.R DB_ENVIRONMENTS ---
# LOCAL_DB_HOST=host.docker.internal
# LOCAL_DB_PORT=5432
# LOCAL_DB_USER=postgres
# SHINY_HOST=0.0.0.0
# SHINY_PORT=3838

# --- Data provider ---
MASSIVE_API_KEY=changeme
