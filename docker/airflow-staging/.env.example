# Copy to .env (never committed); tools/staging_refresh.sh airflow writes it for you.
# Staging's values only. Never put a prod login here: this scheduler must not be able to reach prod.
STAGING_DB_PASSWORD=REPLACEME
MASSIVE_API_KEY=REPLACEME
AIRFLOW_SECRET_KEY=REPLACEME
# The staging Airflow UI (http://localhost:8082), user kevin.
AIRFLOW_UI_PASSWORD=REPLACEME
