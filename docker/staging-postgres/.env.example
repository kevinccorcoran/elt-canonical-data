# Copy to .env (never committed). Read by docker compose and by tools/staging_refresh.sh.
# The staging server's superuser password: the same one dbt, the DAGs and the dashboard use for staging.
POSTGRES_PASSWORD=REPLACEME
# Where the newest prod dump lives on this Mac (about 2.5 GB, compressed). Outside every repo.
STAGING_DUMP_DIR=/Users/YOU/alphastream-dumps
# The published port. 5432 once the Homebrew server is retired; 5433 while both run.
STAGING_PORT=5432
