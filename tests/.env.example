# Copy to tests/.env (gitignored) and fill in.

# --- local dev database: the native Postgres the dashboard reads (127.0.0.1:5432) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=dev
DB_USER=postgres
DB_PASSWORD=

# --- WhatsApp via CallMeBot: https://www.callmebot.com/blog/free-api-whatsapp-messages/ ---
# 1) add +34 623 80 11 90 to your phone contacts
# 2) WhatsApp it: "I allow callmebot to send me messages"
# 3) it replies with your apikey
WHATSAPP_PHONE=+31...
CALLMEBOT_APIKEY=

# environment label stamped into every message body, e.g. "[dev] 🔴 COKE: hold → sell"
# (defaults to DB_NAME when unset)
BOARD_ENV=dev
