if [[ "$HOSTNAME" != "elt-runtime-prod" ]]; then
  echo "ERROR: prod environment cannot be loaded on this machine"
  return 1
fi

export ENV=prod
export DB_HOST=dbaas-db-4718169-do-user-32264340-0.l.db.ondigitalocean.com
export DB_PORT=25060
export DB_USER=doadmin
export DB_PASSWORD="REPLACEME_ON_SERVER"
export DB_DATABASE=prod
export DB_SSLMODE=require

# Ingestion target URL
export DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_DATABASE}?sslmode=${DB_SSLMODE}"
